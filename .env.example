# ===========================
# PostgreSQL
# ===========================
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=tfg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ===========================
# PgAdmin
# ===========================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=changeme

# ===========================
# Azure DevOps
# ===========================
# NOTA: el proyecto usa actualmente dos juegos de variables distintos para
# Azure DevOps según el componente (deuda técnica pendiente de unificar):
#   - scripts/sync_ado_to_postgres.py y sync_service.py usan ADO_*
#   - tfg-backend/backend/config.py (resto del backend) usa AZURE_DEVOPS_*
# Hay que rellenar AMBOS para que todo el sistema funcione correctamente.
ADO_ORG=your-org
ADO_PROJECT=your-project
ADO_PAT=your-personal-access-token

AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=your-personal-access-token

# ===========================
# Azure OpenAI
# ===========================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=your-default-chat-deployment
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=your-embeddings-deployment

# ===========================
# Frontend
# ===========================
BACKEND_URL=http://backend:8000
